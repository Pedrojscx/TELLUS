---
import Base from "../../layouts/Base.astro";
import SeloExemplo from "./SeloExemplo.astro";
import NavComparacao from "./NavComparacao.astro";
import SeletorIdioma from "../SeletorIdioma.astro";
interface Props { titulo: string; atual: string; subtitulo?: string; exemplo?: boolean }
const { titulo, atual, subtitulo, exemplo = false } = Astro.props;
---
<Base titulo={`TELLUS · ${titulo}${exemplo ? " (exemplo)" : ""}`}>
  {exemplo && <SeloExemplo />}
  <header class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 pt-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <a href="/" class="inline-flex items-center gap-2 text-xl font-bold tracking-tight text-tellus-primaria"><img src="/favicon.svg" alt="" width="28" height="28" />TELLUS</a>
        <div class="flex flex-wrap items-center gap-3"><a href="/" class="text-sm text-tellus-primaria underline">← Trocar a lavoura</a><SeletorIdioma /></div>
      </div>
      <h1 class="mt-1 text-lg font-semibold">{titulo}</h1>
      {subtitulo && <p class="text-sm text-stone-600">{subtitulo}</p>}
    </div>
    <NavComparacao atual={atual} />
  </header>
  <main class="mx-auto max-w-5xl space-y-5 px-4 py-5">
    <slot />
  </main>
</Base>
