---
import Base from "../../layouts/Base.astro";
import SeloExemplo from "./SeloExemplo.astro";
import NavComparacao from "./NavComparacao.astro";
interface Props { titulo: string; atual: string; subtitulo?: string }
const { titulo, atual, subtitulo } = Astro.props;
---
<Base titulo={`TELLUS · ${titulo} (exemplo)`}>
  <SeloExemplo />
  <header class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 pt-3">
      <a href="/comparacao" class="text-xl font-bold tracking-tight text-emerald-800">TELLUS</a>
      <h1 class="mt-1 text-lg font-semibold">{titulo}</h1>
      {subtitulo && <p class="text-sm text-stone-600">{subtitulo}</p>}
    </div>
    <NavComparacao atual={atual} />
  </header>
  <main class="mx-auto max-w-5xl space-y-5 px-4 py-5">
    <slot />
  </main>
</Base>
