---
// Premissas editáveis (#102, FR-004): padrão e editado visíveis, unidade e faixa validadas, origem preservada.
// Premissa SEM padrão com fonte (preço do sorgo, D-005): só entra com valor, origem e data informados pelo
// produtor; nunca se grava um preço padrão. O "efeito no resultado" real exige o motor da 008.
import { carregarExemplo } from "../../lib/comparacao/contrato-provisorio";
const premissas = carregarExemplo().premissas;
const grupos = [["solo", "Solo"], ["economica", "Economia"], ["cultura", "Cultura"]] as const;
const n = (v: number) => v.toLocaleString("pt-BR");
---
<div id="editor-premissas" class="space-y-5">
  <p id="padroes-reais" role="status" class="hidden rounded-md bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-900"></p>
  {grupos.map(([tipo, titulo]) => premissas.some((p) => p.tipo === tipo) && (
    <section class="rounded-xl border border-stone-200 bg-white p-4">
      <h2 class="font-semibold">{titulo}</h2>
      <ul class="mt-2 divide-y divide-stone-100">
        {premissas.filter((p) => p.tipo === tipo).map((p) => p.exige_cotacao ? (
          <li class="py-3" data-cotacao={p.id}>
            <fieldset class="space-y-2">
              <legend class="font-medium">{p.nome}</legend>
              <p class="rounded-md border border-amber-300 bg-amber-50 px-3 py-1.5 text-sm text-amber-950">{p.sem_padrao_motivo}</p>
              <div class="grid gap-2 sm:grid-cols-[10rem_1fr_11rem]">
                <label class="text-xs text-stone-700">Valor ({p.unidade})
                  <input name="valor" inputmode="decimal" placeholder="ex.: 50,00" aria-required="true"
                    class="mt-0.5 block w-full rounded-md border border-stone-300 px-2 py-1.5 tabular-nums" />
                </label>
                <label class="text-xs text-stone-700">Origem informada
                  <input name="origem" placeholder="ex.: cooperativa X, Rio Verde" aria-required="true" maxlength="200"
                    class="mt-0.5 block w-full rounded-md border border-stone-300 px-2 py-1.5" />
                </label>
                <label class="text-xs text-stone-700">Data da cotação
                  <input name="data" type="date" aria-required="true"
                    class="mt-0.5 block w-full rounded-md border border-stone-300 px-2 py-1.5" />
                </label>
              </div>
              <p class="text-xs text-stone-500">Os três campos são obrigatórios. Faixa aceita {n(p.minimo)} a {n(p.maximo)} {p.unidade}.</p>
              <ul data-erros class="space-y-0.5 text-xs text-red-700" role="alert"></ul>
              <p data-saida aria-live="polite" class="text-xs text-stone-700">Sem cotação: a margem desta cultura fica indisponível.</p>
            </fieldset>
          </li>
        ) : (
          <li class="grid gap-2 py-3 sm:grid-cols-[1fr_auto]" data-premissa={p.id}>
            <div>
              <label for={`p-${p.id}`} class="font-medium">{p.nome}</label>
              <p class="text-xs text-stone-600">Padrão: <strong data-padrao class="tabular-nums">{p.padrao == null ? "—" : n(p.padrao)} {p.unidade}</strong>
                · faixa aceita {n(p.minimo)} a {n(p.maximo)}</p>
              <p data-fonte class="text-xs text-stone-500">Fonte do padrão: {p.proveniencia.fonte}{p.proveniencia.situacao === "hipotese" ? " · hipótese" : ""}</p>
            </div>
            <div class="sm:w-56">
              <div class="flex items-center gap-2">
                <input id={`p-${p.id}`} inputmode="decimal" placeholder={p.padrao == null ? "" : n(p.padrao)}
                  class="w-full min-w-0 rounded-md border border-stone-300 px-2 py-1.5 tabular-nums" aria-describedby={`d-${p.id}`} />
                <span class="shrink-0 text-xs text-stone-600">{p.unidade}</span>
              </div>
              <p id={`d-${p.id}`} data-saida class="mt-1 text-xs text-stone-600" aria-live="polite">Usando o padrão.</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <section class="rounded-xl border border-stone-200 bg-white p-4" aria-live="polite">
    <h2 class="font-semibold">Padrão × editado</h2>
    <div id="comparativo" class="mt-2 text-sm text-stone-700">Nenhuma premissa editada.</div>
    <div id="informadas" class="mt-3 text-sm text-stone-700"></div>
    <p class="mt-3 rounded-md bg-stone-100 px-3 py-2 text-xs text-stone-700">
      As premissas editadas entram no cálculo real ao abrir o Resultado com a lavoura escolhida na tela inicial; lá cada uma aparece como "padrão → novo valor".
    </p>
    <button type="button" id="restaurar" class="mt-2 text-sm text-stone-600 underline">Voltar tudo ao padrão</button>
  </section>
</div>

<script>
  import { carregarExemplo, type Premissa } from "../../lib/comparacao/contrato-provisorio";
  import { aplicarEdicao, diferenca, editadas, fmt, mesclarPremissas, validarCotacao } from "../../lib/comparacao/premissas";
  import { hojeISO } from "../../lib/comparacao/validacao";
  import { carregarPadroes } from "../../lib/comparacao/padroes";
  import { lerLavoura } from "../../lib/comparacao/lavoura";
  import * as sessao from "../../lib/comparacao/sessao";

  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  let premissas: Premissa[] = mesclarPremissas(carregarExemplo().premissas, sessao.ler()?.premissas);

  function salvar() {
    const atual = sessao.ler();
    sessao.gravar({ exemplo: true, entradas: atual?.entradas ?? { ...sessao.VAZIA }, premissas });
  }

  function comparativo() {
    const ed = editadas(premissas);
    document.getElementById("comparativo")!.innerHTML = ed.length
      ? `<table class="w-full"><thead><tr class="text-left text-xs text-stone-500"><th class="py-1">Premissa</th><th class="py-1 text-right">Padrão</th><th class="py-1 text-right">Editado</th><th class="py-1 text-right">Diferença</th></tr></thead><tbody>${ed
          .map((p) => { const d = diferenca(p)!; return `<tr class="border-t border-stone-100"><td class="py-1">${esc(p.nome)}</td><td class="py-1 text-right tabular-nums">${fmt(p.padrao!)}</td><td class="py-1 text-right tabular-nums font-medium text-sky-800">${fmt(p.editado!)}</td><td class="py-1 text-right tabular-nums">${d.absoluta > 0 ? "+" : ""}${fmt(d.absoluta)} ${esc(p.unidade)}${d.percentual != null ? ` (${d.percentual > 0 ? "+" : ""}${fmt(d.percentual, 1)}%)` : ""}</td></tr>`; })
          .join("")}</tbody></table>`
      : "Nenhuma premissa editada.";
    const inf = premissas.filter((p) => p.exige_cotacao);
    document.getElementById("informadas")!.innerHTML = inf.map((p) => p.cotacao
      ? `<p><strong>${esc(p.nome)}</strong>: ${fmt(p.cotacao.valor)} ${esc(p.unidade)} · <span class="rounded bg-sky-100 px-1.5 text-xs font-semibold text-sky-900">informada pelo produtor</span> · origem: ${esc(p.cotacao.origem_informada)} · data: ${esc(p.cotacao.data_informada)} · padrão: sem cotação oficial</p>`
      : `<p><strong>${esc(p.nome)}</strong>: sem cotação informada — a margem fica indisponível.</p>`).join("");
  }

  // premissas com padrão: edição livre
  document.querySelectorAll<HTMLLIElement>("[data-premissa]").forEach((li) => {
    const id = li.dataset.premissa!;
    const input = li.querySelector("input")!;
    const saida = li.querySelector<HTMLElement>("[data-saida]")!;
    const p0 = premissas.find((p) => p.id === id)!;
    if (p0.editado != null) input.value = fmt(p0.editado);
    const mostrar = (p: Premissa, erro: string | null) => {
      input.setAttribute("aria-invalid", erro ? "true" : "false");
      input.classList.toggle("border-red-500", Boolean(erro));
      saida.className = `mt-1 text-xs ${erro ? "text-red-700" : p.editado != null ? "text-sky-800" : "text-stone-600"}`;
      saida.textContent = erro ?? (p.editado != null && p.padrao != null ? `Editado por você (padrão ${fmt(p.padrao)} ${p.unidade}).` : "Usando o padrão.");
    };
    mostrar(p0, null);
    input.addEventListener("input", () => {
      const i = premissas.findIndex((p) => p.id === id);
      const { premissa, erro } = aplicarEdicao(premissas[i], input.value);
      if (!erro) { premissas[i] = premissa; salvar(); comparativo(); }
      mostrar(premissa, erro);
    });
  });

  // premissas sem padrão (cotação do produtor): valor, origem e data, todos obrigatórios
  document.querySelectorAll<HTMLLIElement>("[data-cotacao]").forEach((li) => {
    const id = li.dataset.cotacao!;
    const campo = (n: string) => li.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
    const errosEl = li.querySelector<HTMLUListElement>("[data-erros]")!;
    const saida = li.querySelector<HTMLElement>("[data-saida]")!;
    const p0 = premissas.find((p) => p.id === id)!;
    if (p0.cotacao) {
      campo("valor").value = fmt(p0.cotacao.valor);
      campo("origem").value = p0.cotacao.origem_informada;
      campo("data").value = p0.cotacao.data_informada;
    }
    campo("data").max = hojeISO();
    const atualizar = (mostrarErros: boolean) => {
      const i = premissas.findIndex((p) => p.id === id);
      const { cotacao, erros } = validarCotacao(premissas[i], { valor: campo("valor").value, origem: campo("origem").value, data: campo("data").value }, hojeISO());
      premissas[i] = { ...premissas[i], cotacao };
      salvar();
      comparativo();
      for (const n of ["valor", "origem", "data"]) {
        const e = erros.find((x) => x.campo === n);
        campo(n).setAttribute("aria-invalid", e && mostrarErros ? "true" : "false");
        campo(n).classList.toggle("border-red-500", Boolean(e && mostrarErros));
      }
      errosEl.innerHTML = mostrarErros ? erros.map((e) => `<li>${esc(e.mensagem)}</li>`).join("") : "";
      saida.innerHTML = cotacao
        ? `<span class="rounded bg-sky-100 px-1.5 font-semibold text-sky-900">informada pelo produtor</span> ${fmt(cotacao.valor)} ${esc(premissas[i].unidade)} · origem: ${esc(cotacao.origem_informada)} · data: ${esc(cotacao.data_informada)}`
        : erros.length ? "Cotação incompleta: a premissa não é usada e a margem fica indisponível." : "Sem cotação: a margem desta cultura fica indisponível.";
    };
    for (const n of ["valor", "origem", "data"]) {
      campo(n).addEventListener("input", () => atualizar(false));
      campo(n).addEventListener("change", () => atualizar(true));
      campo(n).addEventListener("blur", () => atualizar(true));
    }
    atualizar(false);
  });

  document.getElementById("restaurar")!.addEventListener("click", () => {
    premissas = premissas.map((p) => ({ ...p, editado: null, cotacao: null }));
    salvar();
    document.querySelectorAll<HTMLInputElement>("[data-premissa] input, [data-cotacao] input").forEach((i) => { i.value = ""; i.dispatchEvent(new Event("input")); });
    comparativo();
  });

  comparativo();

  // Padrões REAIS da lavoura escolhida (CEPEA, Conab, classe do ZARC). Sem lavoura ou sem servidor: fica o exemplo.
  (async () => {
    const lav = lerLavoura();
    if (!lav) return;
    const reais = await carregarPadroes(lav, sessao.ler()?.entradas);
    if (!Object.keys(reais).length) return;
    premissas = premissas.map((p) => (reais[p.id] ? { ...p, padrao: reais[p.id].padrao, proveniencia: reais[p.id].proveniencia } : p));
    for (const [id, r] of Object.entries(reais)) {
      const li = document.querySelector<HTMLLIElement>(`[data-premissa="${id}"]`);
      if (!li) continue;
      const un = premissas.find((p) => p.id === id)!.unidade;
      li.querySelector("[data-padrao]")!.textContent = `${fmt(r.padrao)} ${un}`;
      li.querySelector("[data-fonte]")!.textContent = `Fonte do padrão: ${r.proveniencia.fonte}${r.proveniencia.situacao === "hipotese" ? " · hipótese" : ""}`;
      li.querySelector("input")!.placeholder = fmt(r.padrao);
    }
    comparativo();
    if (Object.keys(reais).length >= 3) {
      document.getElementById("selo-exemplo")?.classList.add("hidden");
      const aviso = document.getElementById("padroes-reais");
      if (aviso) { aviso.textContent = `Padrões reais para ${lav.municipio}-${lav.uf}.`; aviso.classList.remove("hidden"); }
    }
  })();
</script>
