---
// Bloco genérico de proveniência (#103, FR-005): fonte, versão, unidade, escala, qualidade e data.
import type { Proveniencia } from "../../lib/comparacao/contrato-provisorio";
interface Props { p: Proveniencia; compacto?: boolean }
const { p, compacto = false } = Astro.props;
const situacao: Record<string, [string, string]> = {
  fonte: ["Com fonte", "bg-emerald-100 text-emerald-900"],
  hipotese: ["Hipótese", "bg-amber-100 text-amber-900"],
  editado: ["Editado por você", "bg-sky-100 text-sky-900"],
  desconhecido: ["Desconhecido", "bg-stone-200 text-stone-800"],
};
const origem: Record<string, string> = {
  fonte: "direto da fonte", cache: "cópia guardada (cache)", referencia_versionada: "série guardada no projeto", exemplo: "exemplo",
};
const [rotulo, cor] = situacao[p.situacao] ?? situacao.desconhecido;
const linhas: [string, string | null | undefined][] = [
  ["Versão", p.versao], ["Unidade", p.unidade], ["Escala", p.escala], ["Qualidade", p.qualidade],
  ["Data do dado", p.obtido_em], ["Origem", p.origem_dados ? origem[p.origem_dados] : null],
];
---
<div class:list={["rounded-md border border-stone-200 bg-stone-50 text-sm", compacto ? "p-2" : "p-3"]}>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="font-medium break-words">{p.fonte}</p>
    <span class:list={["rounded px-2 py-0.5 text-xs font-semibold", cor]}>{rotulo}</span>
  </div>
  <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-xs text-stone-700">
    {linhas.map(([k, v]) => (
      <>
        <dt class="text-stone-500">{k}</dt>
        <dd class="break-words">{v ?? <span class="italic text-stone-500">não informado</span>}</dd>
      </>
    ))}
  </dl>
</div>
