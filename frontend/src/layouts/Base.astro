---
import "../styles/global.css";
interface Props {
  titulo?: string;
}
const { titulo = "TELLUS" } = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <title>{titulo}</title>
  </head>
  <body class="min-h-screen bg-tellus-fundo font-tellus text-tellus-texto antialiased">
    <slot />
  </body>
</html>
