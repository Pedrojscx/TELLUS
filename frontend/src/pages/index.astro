---
import Base from "../layouts/Base.astro";
import SeletorLocal from "../components/SeletorLocal.astro";
import ReferenciasLocal from "../components/ReferenciasLocal.astro";
---

<Base titulo="TELLUS · segunda safra">
  <header class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-4">
      <p class="text-xl font-bold tracking-tight text-emerald-800">TELLUS</p>
      <p class="text-sm text-stone-600">Milho, sorgo ou cobertura depois da soja: risco e margem com dados NASA e fontes oficiais.</p>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-6">
    <SeletorLocal />
    <ReferenciasLocal />
  </main>
</Base>
